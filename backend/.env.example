# Server
NODE_ENV=development
PORT=5000

# Database (get the real value from Person A, never commit it)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=SafeHer

# Authentication
JWT_SECRET=your_jwt_secret_here

# Firebase Cloud Messaging (path to the service account key file)
FIREBASE_SERVICE_ACCOUNT=./firebase-key.json

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# Google Maps (needed from Week 2)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Frontend
FRONTEND_URL=http://localhost:8081